# Copy to `.env.local` and fill in. All vars are optional.

# Worker/WebSocket base URL (defaults to wss://poocho.manishbisht.workers.dev)
VITE_WS_URL=

# Microsoft Clarity project id (https://clarity.microsoft.com → Settings → Overview).
# Leave empty to disable analytics; Clarity only loads when this is set.
VITE_CLARITY_PROJECT_ID=

# Dev-only: skip upload and watch a known video id directly.
VITE_VIDEO_ID=
